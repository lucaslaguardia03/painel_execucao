// ── Concatena tudo ───────────────────────────────────────────────────────────
LOAD * FROM data-historico\loa_rec.qvd (qvd);
CONCATENATE
LOAD * FROM data-historico\loa_desp.qvd (qvd);
CONCATENATE
LOAD * FROM data-historico\ldo_rec.qvd (qvd);
CONCATENATE
LOAD * FROM data-historico\ldo_desp.qvd (qvd);
CONCATENATE
LOAD * FROM data-historico\exec_rec.qvd (qvd);
CONCATENATE
LOAD * FROM data-historico\exec_desp.qvd (qvd);
CONCATENATE
LOAD * FROM data-historico\exec_rp.qvd (qvd);
CONCATENATE
LOAD * FROM data-historico\exec_rp_folha.qvd (qvd);
CONCATENATE
LOAD * FROM data-historico\exec_suplementacao.qvd (qvd);
CONCATENATE
LOAD * FROM data-historico\exec_pago_orc.qvd (qvd);



