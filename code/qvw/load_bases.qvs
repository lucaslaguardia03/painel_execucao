// ── Carrega os históricos em QVD ──────────────────────────────────

IF FileSize('data-historico\loa_rec.csv') > 0 THEN
loa_rec_hist:
LOAD * FROM data-historico\loa_rec.csv (txt, utf8, embedded labels, delimiter is ';', msq);
STORE loa_rec_hist INTO data-historico\loa_rec.qvd (qvd);
DROP TABLE loa_rec_hist;
END IF;

IF FileSize('data-historico\loa_desp.csv') > 0 THEN
loa_desp_hist:
LOAD * FROM data-historico\loa_desp.csv (txt, utf8, embedded labels, delimiter is ';', msq);
STORE loa_desp_hist INTO data-historico\loa_desp.qvd (qvd);
DROP TABLE loa_desp_hist;
END IF;

